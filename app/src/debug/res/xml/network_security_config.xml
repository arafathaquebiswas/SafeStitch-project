<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only: also allow plain http to a sync test server on this computer
     (10.0.2.2 is the Mac as seen from the Android emulator). Release builds use the https-only file in src/main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
